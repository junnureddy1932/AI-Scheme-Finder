# ==============================================================================
# JanSahayak AI — Environment Configuration Example
# ==============================================================================

# --- Backend Configuration (FastAPI) ---
PROJECT_NAME="JanSahayak AI — Your Government Benefits Assistant"
API_V1_STR="/api"

# Database Connection:
# For production (PostgreSQL on Supabase, Neon, Render, or Railway):
# DATABASE_URL="postgresql://user:password@localhost:5432/jansahayak"
# For immediate local development (defaults to zero-config SQLite):
DATABASE_URL="sqlite:///./jansahayak.db"

# Security & Authentication:
SECRET_KEY="replace-with-a-secure-random-secret-key-at-least-32-characters-long"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# AI / LLM Configuration (Optional):
# If keys are left empty, JanSahayak activates its intelligent rule-grounded RAG fallback engine.
GEMINI_API_KEY=""
OPENAI_API_KEY=""

# Allowed CORS Origins (comma-separated if configured via environment)
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# --- Frontend Configuration (Next.js) ---
NEXT_PUBLIC_API_URL="http://127.0.0.1:8000/api"
